{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Private authenticated dealer or founder profile synced from Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name from Google profile.",
          "minLength": 0,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address (PII).",
          "minLength": 3,
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "description": "Optional Google avatar URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set at initial profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp updated on profile sync."
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "createdAt", "updatedAt"]
    },
    "CartItemRecord": {
      "title": "Cart Item Record",
      "description": "Single electrical SKU quantity entry in a signed-in user's trial basket subcollection.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this basket item.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "description": "D&D Group SKU identifier matching the document ID.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "qty": {
          "type": "integer",
          "description": "Selected unit quantity between 1 and 999."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last basket quantity update."
        }
      },
      "required": ["ownerId", "productId", "qty", "updatedAt"]
    },
    "CatalogProductOverride": {
      "title": "Catalog Product Override or Custom SKU",
      "description": "Admin-managed electrical product pricing, photo, specifications, description, and stock metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "SKU code matching the document ID.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "spec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "price": {
          "type": "number",
          "description": "Wholesale dealer rate in INR."
        },
        "mrp": {
          "type": "number",
          "description": "Optional retail MRP in INR (0 when omitted)."
        },
        "moq": {
          "type": "integer",
          "description": "Minimum order quantity per order."
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "description": "Detailed product description, warranty, and packaging notes.",
          "minLength": 0,
          "maxLength": 1500
        },
        "imageUrl": {
          "type": "string",
          "description": "HTTPS photo URL or compressed base64 image data URI (<= 160KB).",
          "minLength": 0,
          "maxLength": 160000
        },
        "inStock": {
          "type": "boolean"
        },
        "isHidden": {
          "type": "boolean"
        },
        "featured": {
          "type": "boolean"
        },
        "isCustom": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "category",
        "family",
        "spec",
        "name",
        "price",
        "mrp",
        "moq",
        "kind",
        "unit",
        "description",
        "imageUrl",
        "inStock",
        "isHidden",
        "featured",
        "isCustom",
        "updatedBy",
        "updatedAt"
      ]
    },
    "BusinessSettingsRecord": {
      "title": "Business Storefront Settings",
      "description": "Admin-editable brand identity, storefront copy, contact details, and display mode.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "minLength": 0, "maxLength": 120 },
        "heroEyebrow": { "type": "string", "minLength": 0, "maxLength": 120 },
        "heroTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "heroSubtitle": { "type": "string", "minLength": 0, "maxLength": 600 },
        "contactPerson": { "type": "string", "minLength": 0, "maxLength": 100 },
        "contactPhone": { "type": "string", "minLength": 0, "maxLength": 24 },
        "whatsappNumber": { "type": "string", "minLength": 0, "maxLength": 24 },
        "contactEmail": { "type": "string", "minLength": 0, "maxLength": 200 },
        "city": { "type": "string", "minLength": 0, "maxLength": 100 },
        "address": { "type": "string", "minLength": 0, "maxLength": 300 },
        "gstNote": { "type": "string", "minLength": 0, "maxLength": 200 },
        "announcementBanner": { "type": "string", "minLength": 0, "maxLength": 300 },
        "showPrototypeNotices": { "type": "boolean" },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "companyName",
        "tagline",
        "heroEyebrow",
        "heroTitle",
        "heroSubtitle",
        "contactPerson",
        "contactPhone",
        "whatsappNumber",
        "contactEmail",
        "city",
        "address",
        "gstNote",
        "announcementBanner",
        "showPrototypeNotices",
        "updatedBy",
        "updatedAt"
      ]
    },
    "TrialOrder": {
      "title": "Trial Order Request",
      "description": "Jaipur electrical dealer trial basket request with bounded SKU snapshot and lifecycle status.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user who created this trial request.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceId": {
          "type": "string",
          "description": "Human-readable trial reference ID matching the document ID.",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "date": { "type": "string", "format": "date-time", "minLength": 10, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "business": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[6-9][0-9]{9}$" },
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "segment": { "type": "string", "minLength": 1, "maxLength": 60 },
        "notes": { "type": "string", "minLength": 0, "maxLength": 800 },
        "items": { "type": "array", "description": "Bounded list (1 to 50) of ordered SKU line items." },
        "total": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["Requested", "Contacted", "Trial confirmed", "Closed"]
        },
        "repeat": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "referenceId",
        "date",
        "name",
        "business",
        "phone",
        "city",
        "segment",
        "notes",
        "items",
        "total",
        "status",
        "repeat",
        "createdAt",
        "updatedAt"
      ]
    },
    "DealerLead": {
      "title": "Dealer Connect Enquiry",
      "description": "Jaipur electrical dealer outreach enquiry capturing sourcing pain points.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": { "type": "string", "format": "date-time", "minLength": 10, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "business": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[6-9][0-9]{9}$" },
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "interest": { "type": "string", "minLength": 1, "maxLength": 80 },
        "currentSupplier": { "type": "string", "minLength": 1, "maxLength": 100 },
        "challenge": { "type": "string", "minLength": 0, "maxLength": 800 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "date",
        "name",
        "business",
        "phone",
        "city",
        "interest",
        "currentSupplier",
        "challenge",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "Admin Allowlist Record",
      "description": "Read-only server-managed RBAC allowlist document for pilot administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile synced from Google Sign-In."
    },
    "/users/{userId}/cartItems/{skuId}": {
      "schema": { "$ref": "#/entities/CartItemRecord" },
      "description": "Per-user trial basket SKU quantities stored as a scalable subcollection."
    },
    "/catalogProducts/{productId}": {
      "schema": { "$ref": "#/entities/CatalogProductOverride" },
      "description": "Publicly readable, strictly admin-writable electrical product catalogue overrides and custom SKUs."
    },
    "/businessSettings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettingsRecord" },
      "description": "Publicly readable (main doc only), strictly admin-writable storefront branding and business details."
    },
    "/trialOrders/{orderId}": {
      "schema": { "$ref": "#/entities/TrialOrder" },
      "description": "Owner-isolated dealer trial basket requests with terminal Closed status protection."
    },
    "/dealerLeads/{leadId}": {
      "schema": { "$ref": "#/entities/DealerLead" },
      "description": "Owner-isolated Jaipur dealer connect enquiries."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Immutable console-managed admin allowlist."
    }
  }
}
